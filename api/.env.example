MYSQL_HOST=127.0.0.1
MYSQL_USER=nate
MYSQL_PASSWORD=replace-me
MYSQL_DATABASE=cfaccounting
JWT_SECRET=replace-with-at-least-32-random-characters
API_HOST=127.0.0.1
API_PORT=5004
CLIENT_ORIGIN=http://localhost:5173
ALLOW_REGISTRATION=true
ACCOUNTING_ARTIFACT_ROOT=./data/artifacts
ACCOUNTING_EVIDENCE_ROOT=./data/evidence
# Stripe Connect, configured on the server. Use the existing platform to adopt
# its live invoices. Register the callback and a connected-account webhook.
# CLIENT_ORIGIN is also the Accounting web origin for returning from Stripe.
# STRIPE_SECRET_KEY=
# STRIPE_CONNECT_CLIENT_ID=
# STRIPE_CONNECT_WEBHOOK_SECRET=
# ACCOUNTING_STRIPE_STATE_SECRET=
# ACCOUNTING_STRIPE_CALLBACK_URL=https://accounting.chapeauxfous.com/api/payments/stripe/oauth/callback
